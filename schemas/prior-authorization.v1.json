{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fiber:prior-authorization:1",
  "title": "Synthetic Humata prior-authorization state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "schema_version", "source", "tenant_id", "source_account_id", "source_encounter_id", "source_sequence", "occurred_at", "published_at", "status", "evidence"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"const": "humata.prior_authorization.state_changed"},
    "schema_version": {"const": 1},
    "source": {"const": "humata-demo"},
    "tenant_id": {"type": "string", "minLength": 1},
    "source_account_id": {"type": "string", "minLength": 1},
    "source_encounter_id": {"type": "string", "minLength": 1},
    "source_sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "occurred_at": {"type": "string", "format": "date-time"},
    "published_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["not_required", "required", "attempted", "submitted", "approved", "denied"]},
    "authorization_number": {"type": "string", "minLength": 1},
    "valid_from": {"type": "string", "format": "date"},
    "valid_to": {"type": "string", "format": "date"},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["uri", "sha256"],
      "properties": {
        "uri": {"type": "string", "pattern": "^humata://evidence/"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "approved"}}},
    "then": {"required": ["authorization_number", "valid_from", "valid_to"]}
  }]
}
