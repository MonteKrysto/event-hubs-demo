# Microsoft emulator license: https://github.com/Azure/azure-event-hubs-emulator-installer/blob/main/LICENSE
# Set Y to accept before starting the emulator.
ACCEPT_EULA=N
# Optional host ports; application containers use internal service addresses.
KAFKA_HOST_PORT=59092
EMULATOR_HEALTH_PORT=55300
POSTGRES_HOST_PORT=55432
WEB_HOST_PORT=58080
# Set debug to include expected socket resets after intentional client shutdown.
KAFKAJS_LOG_LEVEL=error
